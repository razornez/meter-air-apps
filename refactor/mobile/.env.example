# === Konfigurasi Mobile (Expo) ===
# Semua var EXPO_PUBLIC_* di-bundle ke dalam app (bersifat publik).
# Salin file ini menjadi `.env` lalu isi nilainya.

# URL backend NestJS. Sertakan sufiks /api.
#  - Emulator Android lokal : http://10.0.2.2:4000/api
#  - HP fisik (LAN)         : http://<IP-PC>:4000/api
#  - Produksi (Railway)     : https://<app>.up.railway.app/api
EXPO_PUBLIC_API_URL=http://10.0.2.2:4000/api

# Midtrans CLIENT key (boleh publik — bukan server key).
EXPO_PUBLIC_MIDTRANS_CLIENT_KEY=

# "true" untuk produksi Midtrans, "false" untuk sandbox.
EXPO_PUBLIC_MIDTRANS_IS_PRODUCTION=false
