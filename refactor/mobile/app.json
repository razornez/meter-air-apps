{
  "expo": {
    "name": "Meter Air",
    "slug": "meter-air",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": false,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.bumdes.meterair"
    },
    "android": {
      "package": "com.bumdes.meterair",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "Aplikasi memerlukan kamera untuk memindai QR meter dan memotret angka meter."
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Aplikasi memerlukan GPS untuk mencatat koordinat lokasi pelanggan saat pencatatan meter."
        }
      ],
      "expo-font",
      [
        "expo-media-library",
        {
          "photosPermission": "Aplikasi memerlukan akses galeri untuk menyimpan kartu pelanggan."
        }
      ]
    ]
  }
}
