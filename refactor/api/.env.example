# ============================================================================
# Template environment. Salin ke `.env` (gitignore) dan isi nilainya.
# SEMUA key & credential HANYA di sini / di env host (Vercel/Railway), bukan di
# kode. Lihat refactor/DEPLOYMENT.md. Jangan commit file `.env` yang terisi.
# ============================================================================

# MySQL (database `pdam` yang sudah ada di XAMPP)
DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=                       # credential — isi password MySQL di sini
DB_DATABASE=pdam

# JWT
JWT_SECRET=ganti-dengan-secret-acak-panjang   # credential — WAJIB diganti di produksi
JWT_EXPIRES_IN=7d

# Server (3000/3001 dipakai app lain di mesin dev → pakai 4000)
PORT=4000

# Keamanan
# NODE_ENV=production → boot gagal bila JWT_SECRET masih default.
NODE_ENV=development
# CORS: kosong = izinkan semua (dev). Produksi: isi domain frontend (pisahkan koma),
# mis. CORS_ORIGIN=https://app.contoh.com,https://admin.contoh.com
CORS_ORIGIN=

# Rate limit global (request per TTL ms / IP). Naikkan THROTTLE_LIMIT saat uji performa.
THROTTLE_LIMIT=120
THROTTLE_TTL=60000

# Folder upload foto meter (relatif terhadap root project)
UPLOAD_DIR=uploads/foto_meter

AUTH_UPGRADE_PLAINTEXT=false
WATER_PRODUCT_BARCODE=B1502200001
