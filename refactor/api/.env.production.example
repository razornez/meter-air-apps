# ============================================================
#  NestJS API (mobile backend) — PRODUKSI di VPS
#  Salin jadi `.env` di VPS lalu isi nilainya.
#  API ini berbagi database YANG SAMA dengan web admin Laravel.
# ============================================================

# --- Database (SAMA dengan web admin di VPS) ---
# Karena API & web admin satu VPS, host = localhost (atau 127.0.0.1).
# Isi user/password/nama DB PERSIS seperti yang dipakai web admin.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USERNAME=meterair_user
DB_PASSWORD=GANTI_PASSWORD_DB
DB_DATABASE=meterair

# --- Keamanan JWT (WAJIB acak & panjang, jangan default) ---
# Bikin dengan: openssl rand -base64 48
JWT_SECRET=GANTI_DENGAN_STRING_ACAK_PANJANG
JWT_EXPIRES_IN=12h

# --- Server ---
PORT=4000
NODE_ENV=production

# Domain mobile yang boleh akses (CORS). Untuk app native tidak wajib,
# tapi isi domain web bila ada panel yang konsumsi API ini.
CORS_ORIGIN=https://api.meterair.id

# Rate limit (boleh dinaikkan saat trafik tinggi)
THROTTLE_TTL=60000
THROTTLE_LIMIT=120

# --- Foto meteran ---
# Foto kini disimpan di DB (BLOB), folder ini hanya fallback file lama.
UPLOAD_DIR=/var/www/meter-air-api/uploads/foto_meter

# Jangan rehash password lama saat login pertama (migrasi mulus)
AUTH_UPGRADE_PLAINTEXT=true

# Barcode produk air (sinkron dengan data)
WATER_PRODUCT_BARCODE=B1502200001

# --- Midtrans (pembayaran) — pakai SERVER key produksi ---
MIDTRANS_MERCHANT_ID=
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_IS_PRODUCTION=true

# --- Seed (HAPUS/biarkan kosong di produksi agar endpoint seed mati aman) ---
# Set string acak bila perlu sekali migrasi, lalu kosongkan lagi.
SEED_SECRET=
